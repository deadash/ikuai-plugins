plugin()
{
    local op="${op:-scan}" name="$name" src base arch
    ikg_eula_accepted || { echo "需要先同意《使用条款》才能使用插件功能"; return 1; }
    test -x "$IK_IKPLUGIN" || { echo "插件系统不可用(缺少 $IK_IKPLUGIN)"; return 1; }
    arch="$IK_PLUGIN_DIR/.installed"

    case "$op" in
        scan)
            "$IK_IKPLUGIN" scan || return 1
            ikg_audit INFO "plugin.scan" "扫描并安装 /etc/mnt/plugins/*.zip"
            echo "已扫描并安装 /etc/mnt/plugins/*.zip"
            ;;
        list)
            "$IK_IKPLUGIN" list
            ;;
        install)
            [ -n "$name" ] || { echo "缺少 name"; return 1; }
            base="$(basename "$name")"
            case "$base" in
                *.zip|*.ZIP) ;;
                *) echo "只支持 .zip 插件包"; return 1 ;;
            esac
            src="$IK_IMPORT_DIR/$base"
            [ -f "$src" ] || { echo "未找到上传的插件包: $base(请先通过上传接口上传)"; return 1; }
            mkdir -p "$arch" 2>/dev/null
            cp -f "$src" "$arch/$base" 2>/dev/null
            if ! "$IK_IKPLUGIN" install "$src"; then
                echo "插件安装失败: $base"
                return 1
            fi
            rm -f "$src" 2>/dev/null
            ikg_audit INFO "plugin.install" "上传安装插件包: $base"
            echo "插件已安装: $base"
            ;;
        remove)
            [ -n "$name" ] || { echo "缺少 name"; return 1; }
            "$IK_IKPLUGIN" remove "$name" || return 1
            ikg_audit INFO "plugin.remove" "卸载插件: $name"
            echo "已卸载: $name"
            ;;
        verify)
            [ -n "$name" ] || { echo "缺少 name"; return 1; }
            "$IK_IKPLUGIN" verify "$name"
            ;;
        *)  echo "不支持的 op: $op" ; return 1 ;;
    esac

    # 插件变更后同步 Web 资源与卡片
    ikg_run_script 03_enable_plugins.sh
    return 0
}

# 系统盘(/etc/mnt)扩容: 这里只写"目标大小"请求, 真正的改盘由开机脚本
# scripts/09_expand_mnt.sh 在启动时完成(用设备自带 fdisk/mke2fs/dd), 会自动重启一次。
# 提交成功 -> 记审计 + 8 秒后自动重启; 失败 -> 记审计并原样把原因返回给页面。
expand()
{
    local op="${op:-pending}" size="${size:-}" out rc max pend

    case "$op" in
    pending)
        pend="$(ikg_expand_pending)"
        if [ -n "$pend" ]; then
            echo "待执行扩容请求: /etc/mnt -> ${pend} MiB(重启后由开机脚本执行)"
        else
            echo "当前没有待执行的扩容请求"
        fi
        ;;

    log)
        ikg_tail_file "$IK_EXPAND_LOG" 100
        ;;

    cancel)
        rm -f "$IK_EXPAND_REQ" "$IK_PLUGIN_DIR/.expand.tries" 2>/dev/null
        ikg_audit INFO "disk.expand" "已撤销扩容请求"
        echo "已撤销扩容请求"
        ;;

    set)
        case "$size" in
        '' | *[!0-9]*) echo "请填写要扩到的系统盘大小"; return 1 ;;
        esac
        test -x "$IK_IKEXPAND" || { echo "缺少扩容工具: $IK_IKEXPAND"; return 1; }
        max="$(ikg_expand_max)"
        if [ -n "$max" ] && [ "$size" -gt "$max" ]; then
            ikg_audit WARN "disk.expand" "拒绝扩容 $(ikg_g "$size"): 超过上限 $(ikg_g "$max")"
            echo "超过上限: 最多 $(ikg_g "$max")(要给日志盘 /etc/log 留出它已占用的空间和 $(ikg_g "$IK_EXPAND_RESERVE") 余量, 且不能动保留分区)"
            return 1
        fi
        out="$("$IK_IKEXPAND" set "$size" 2>&1)"
        rc=$?
        if [ "$rc" != 0 ]; then
            ikg_audit WARN "disk.expand" "扩容请求失败($(ikg_g "$size")): $(printf '%s' "$out" | tr '\n' ' ')"
            printf '%s\n' "$out"
            return 1
        fi
        ikg_audit INFO "disk.expand" "已提交扩容请求: /etc/mnt -> $(ikg_g "$size"), 即将重启执行"
        printf '%s\n' "$out"
        echo "即将重启设备完成扩容: 启动过程中自动改盘, 期间会再自动重启一次(约 1~2 分钟)"
        # 留几秒给页面显示提示, 然后重启; trap 忽略 HUP, 免得请求结束把这个子进程带走
        (trap '' HUP; sleep 8; reboot) >/dev/null 2>&1 &
        ;;

    *)
        echo "不支持的 op: $op"
        return 1
        ;;
    esac
    return 0
}

# 自定义自检: 即时完成(几十次 fork), 检查五件事:
#   1) 5 个云端客户端是否都被换成了空壳
#   2) /etc/hosts 里的云端域名封锁条目数
#   3) 是否还有后门进程存活
#   4) stub.log 里最近的"启动尝试"(应该为空 —— 有记录=发现了新的启动点)
#   5) SSH 加固(公网访问是否已封禁、封了几个来源 IP)
# 结果同时写 last-check.txt 供页面回看。不参与 cron, 也不在开机时执行。
check()
{
    local out="" f alive hosts n
    alive="$(ikg_backdoor_alive)"
    hosts="$(grep -c '0\.0\.0\.0' "$IK_HOSTS" 2>/dev/null)"
    case "$hosts" in ''|*[!0-9]*) hosts=0 ;; esac

    out="=== 封锁自检 $(date '+%Y-%m-%d %H:%M:%S') ==="
    out+=$'\n1) 空壳替换:'
    for f in /usr/sbin/ik_rc_client /usr/sbin/cre /usr/sbin/pmd /usr/sbin/dtalkd /usr/sbin/dtalkc; do
        if grep -q '\[ikblock\]' "$f" 2>/dev/null; then
            out+=$'\n     [OK] '"$f"
        else
            out+=$'\n     [!!] '"$f"' 未替换为空壳'
        fi
    done
    out+=$'\n2) hosts 域名封锁: '"$hosts"' 条(0.0.0.0)'
    out+=$'\n3) 后门进程: '"${alive:-无}"
    out+=$'\n4) 启动尝试监控: 本次开机 '"$(ikg_stub_new)"' 条(历史累计 '"$(ikg_stub_total)"' 条)'
    if [ "$(ikg_stub_new)" != "0" ]; then
        out+=$'\n'"$(tail -n 6 "$IK_STUB_LOG" 2>/dev/null)"
        out+=$'\n     [!!] 本次开机有组件尝试启动被禁后门 —— 上面是时间与拉起者, 需要排查'
    else
        out+=$'\n     [OK] 本次开机没有任何启动尝试(历史记录只作存档)'
    fi

    out+=$'\n5) SSH 加固:'
    out+=$'\n'"$(sg_check_text | tail -n +2 | sed 's/^/     /')"

    mkdir -p "$IK_LOG_DIR" 2>/dev/null
    printf '%s\n' "$out" > "$IK_CHECK_OUT" 2>/dev/null
    ikg_audit INFO "check" "自检: 进程=${alive:-无} hosts=$hosts 条 stub记录=$([ -s "$IK_STUB_LOG" ] && echo 有 || echo 无) ssh封禁=$(sg_ban_count) 条"
    printf '%s\n' "$out"
    return 0
}

logclear()
{
    # 当天日志 + 滚动出来的 .1 一起清, 避免留下半截历史
    local k
    mkdir -p "$IK_LOG_DIR" 2>/dev/null
    for k in audit conn dns; do
        : > "$IK_LOG_DIR/$k-$(date +%Y%m%d).log" 2>/dev/null
        rm -f "$IK_LOG_DIR/$k-"*.log.1 2>/dev/null
    done
    Syslog "[ikguard] 审计日志已清空"
    echo "审计日志已清空"
    return 0
}

# ---------------------------------------------------------------- SSH 加固动作

# 一键封禁/解封来源 IP。封的是"该 IP 访问本机 SSH 端口"(Web 与其它服务不受影响, 所以
# 即便手滑封了自己所在网段, 也能从网页解封)。名单落在持久盘 /etc/mnt/ikguard/ssh-ban.list,
# 重启后由 scripts/07_enable_sshguard.sh 重放。
sshban()
{
    local op="${op:-ban}" ip="${ip:-}" n
    case "$op" in
        ban)
            [ -n "$ip" ] || { echo "缺少 ip 参数"; return 1; }
            sg_ban_add "$ip" "${note:-手工封禁}" >/dev/null || { echo "封禁失败: $ip"; return 1; }
            Syslog "[ikguard] 封禁 SSH 来源 $ip"
            ikg_audit WARN "ssh.ban" "封禁来源 IP $ip (${note:-手工封禁})"
            echo "已封禁 $ip 访问本机 SSH(Web 不受影响, 随时可解封)"
            ;;
        unban)
            [ -n "$ip" ] || { echo "缺少 ip 参数"; return 1; }
            sg_ban_del "$ip" >/dev/null || { echo "解封失败: $ip"; return 1; }
            Syslog "[ikguard] 解除 SSH 封禁 $ip"
            ikg_audit INFO "ssh.unban" "解除封禁 $ip"
            echo "已解除封禁 $ip"
            ;;
        clear)
            n="$(sg_ban_count_file)"
            sg_ban_clear >/dev/null
            Syslog "[ikguard] 清空 SSH 封禁名单"
            ikg_audit INFO "ssh.unban" "清空封禁名单(${n:-0} 条)"
            echo "已清空封禁名单(${n:-0} 条)"
            ;;
        *)
            echo "op 只支持 ban|unban|clear"
            return 1
            ;;
    esac
    return 0
}
