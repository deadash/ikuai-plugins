#!/bin/bash /etc/ikcommon
#
# ikguard - 安全防护控制台后端接口
# 页面: 系统设置 -> 插件管理 -> ikguard (前端 /plugins/app/ikguard.html)
#
# 动作:
#   show    TYPE=data,flags,plugins,eula,logs,probe,disk  读取状态/开关/插件/条款/日志/自检/磁盘
#   seting  key=<配置项> value=<0|1>                 修改 /etc/mnt/boot_args 开关并立即生效
#           (probe=1 加入定时自检, =0 移除; 其余开关见前端列表)
#   eula    op=accept|reject                         记录《使用条款》是否已同意(插件功能前置条件)
#   apply   -                                        重新应用后门阻断 + 审计
#   plugin  op=scan|install|remove|list [name=...]    插件管理(install 用于安装刚上传的 zip)
#   probe   -                                        云端连通性自检(手动立即执行一次)
#   expand  op=set|pending|cancel|log size=<MiB>      系统盘(/etc/mnt)扩容(提交后重启执行)
#   logclear -                                       清空审计日志(含滚动出的 .1)
#
# 审计取证(audit=1)是**常驻被动采集进程**(conntrack 事件 + 内核封锁日志), 不占 cron;
# DNS 只是连接事件里 dport=53 的子集, 不再单独抓包/单独开关。
#
# 说明: 本文件通过 /usr/ikuai/function/ikguard 软链被 func_api.sh 分发,
#       stdout 必须是合法 JSON(show) 或错误信息(失败时), 日志写文件不要污染 stdout。

BOOT_DIR="/etc/mnt/.boot"
BOOT_ARGS="/etc/mnt/boot_args"
IK_LOG_DIR="/etc/log/ikguard"
IK_PLUGIN_DIR="/etc/mnt/plugins"
IK_IMPORT_DIR="/tmp/iktmp/import"
IK_EULA_FILE="$IK_PLUGIN_DIR/.eula"
IK_EULA_TEXT="$BOOT_DIR/www/eula.txt"
IK_EULA_VER="v1.0"
IK_IKPLUGIN="$BOOT_DIR/bin/ikplugin"
IK_IKAUDIT="$BOOT_DIR/bin/ikaudit"
IK_PROBE_OUT="$IK_LOG_DIR/last-probe.txt"
IK_AU_PIDFILE="/tmp/.ikaudit/collect.pid"   # 被动采集器 pid 文件(由 ikaudit collect-start 写入)

# 系统盘(/etc/mnt)扩容:
#   /etc/mnt 出厂只有 43.4M, 装不下带二进制的插件; 设备上还有 15.5G 的 /etc/log。
#   bin/ikexpand 把"目标大小"写成请求(/etc/mnt/.expand), 开机脚本
#   scripts/09_expand_mnt.sh 在启动时用设备自带 fdisk/mke2fs/dd 完成一次扩容,
#   期间会自动再重启一次。全过程日志: /etc/log/ikguard/expand.log
IK_IKEXPAND="$BOOT_DIR/bin/ikexpand"
IK_EXPAND_LOG="$IK_LOG_DIR/expand.log"
IK_EXPAND_REQ="$IK_PLUGIN_DIR/.expand"
# 扩容时给日志盘(/etc/log)保留的余量(MiB): 目标大小不能吃掉它已占用的空间和这个余量
IK_EXPAND_RESERVE=256

# ---------------------------------------------------------------- 工具

# 转义为 JSON 字符串内容
ikg_esc() {
    sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' | tr -d '\r' | \
    awk 'BEGIN{ORS=""} {printf "%s%s", (NR>1?"\\n":""), $0}'
}

ikg_text() {
    printf '"%s"' "$(printf '%s' "$1" | ikg_esc)"
}

ikg_kv() {
    printf '"%s":%s' "$1" "$(ikg_text "$2")"
}

ikg_num() {
    case "$2" in ''|*[!0-9]*) printf '"%s":0' "$1" ;; *) printf '"%s":%s' "$1" "$2" ;; esac
}

ikg_flag() { sed -n "s/^$1=//p" "$BOOT_ARGS" 2>/dev/null | head -n1; }

ikg_tail_file() {
    local f="$1" n="${2:-100}"
    test -f "$f" && tail -n "$n" "$f" 2>/dev/null
}

ikg_day_file() {
    local f="$IK_LOG_DIR/$1-$(date +%Y%m%d).log"
    test -f "$f" || f="$(ls -1t "$IK_LOG_DIR/$1"-*.log 2>/dev/null | head -n1)"
    printf '%s' "$f"
}

# 后门进程存活情况(空格分隔)
ikg_backdoor_alive() {
    local out="" p
    for p in ik_rc_client cre cre_client pmd dtalkd dtalkc catcherd; do
        pidof "$p" >/dev/null 2>&1 && out="$out $p"
    done
    printf '%s' "${out# }"
}

# 封锁规则命中包数
ikg_blocked_hits() {
    { iptables -nvx -L OUTPUT 2>/dev/null; iptables -nvx -L FORWARD 2>/dev/null; } | \
        awk '/ikuai_blk|multiport/{s+=$1} END{print s+0}'
}

# 被动采集器是否在运行(与 ikaudit 一致: 只认 pid 文件)
ikg_collect_running() {
    local pid=""
    test -f "$IK_AU_PIDFILE" && read -r pid < "$IK_AU_PIDFILE"
    [ -n "$pid" ] || return 1
    [ -d "/proc/$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

# 内核封锁日志(-j LOG)是否可用 —— 用于"封锁命中"事件化
ikg_xt_ok() {
    iptables -j LOG -h 2>&1 | grep -q 'log-prefix'
}

# 今日某类事件条数(按事件名统计, 避免把旧格式内容算进来)
ikg_count() {
    local f pat="$2"
    f="$(ikg_day_file "$1")"
    [ -f "$f" ] || { printf '0'; return 0; }
    if [ -n "$pat" ]; then
        grep -cE "$pat" "$f" 2>/dev/null || printf '0'
    else
        grep -c . "$f" 2>/dev/null || printf '0'
    fi
}

# 审计事件(与 lib/audit.sh 相同格式, 便于同一份日志里检索)
ikg_audit() {
    local level="$1" event="$2"
    shift 2
    mkdir -p "$IK_LOG_DIR" 2>/dev/null
    printf '%s %-5s %-18s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$level" "$event" "$*" \
        >> "$IK_LOG_DIR/audit-$(date +%Y%m%d).log" 2>/dev/null
}

# 运行框架脚本(按开关)
ikg_run_script() {
    local s="$BOOT_DIR/scripts/$1"
    test -x "$s" || { bash "$s" >/dev/null 2>&1; return $?; }
    "$s" >/dev/null 2>&1
}

# ---------------------------------------------------------------- 使用条款

ikg_eula_accepted() {
    test -f "$IK_EULA_FILE" || return 1
    grep -q "^accepted=1" "$IK_EULA_FILE" 2>/dev/null
}

ikg_eula_text() {
    test -f "$IK_EULA_TEXT" && cat "$IK_EULA_TEXT" 2>/dev/null
}

# ---------------------------------------------------------------- show

__show_data() {
    local status ver procs usage
    ver="$(sed -n 's/^version=//p' "$BOOT_DIR/Release" 2>/dev/null | head -n1)"
    procs="$(ikg_backdoor_alive)"
    usage="$(df -h "$IK_LOG_DIR" 2>/dev/null | tail -n1 | awk '{printf "%s 总 / %s 可用 / %s 已用", $2, $4, $5}')"

    status="{"
    status+="$(ikg_kv version "$ver"),"
    status+="$(ikg_kv plugins_ok "$(cat /etc/plugins_ok 2>/dev/null)"),"
    status+="$(ikg_kv backdoor_alive "$procs"),"
    status+="$(ikg_num ipset "$(ipset -L ikuai_blk 2>/dev/null | grep -c '^[0-9]')"),"
    status+="$(ikg_num rules "$(iptables -S 2>/dev/null | grep -c ikuai_blk)"),"
    status+="$(ikg_num collect_running "$(ikg_collect_running && echo 1 || echo 0)"),"
    status+="$(ikg_num xt_ok "$(ikg_xt_ok && echo 1 || echo 0)"),"
    status+="$(ikg_num n_conn "$(ikg_count conn 'conn\.(NEW|DESTROY)')"),"
    status+="$(ikg_num n_dns "$(ikg_count dns 'dns\.query')"),"
    status+="$(ikg_num n_block "$(ikg_count block 'block\.hit')"),"
    status+="$(ikg_num blocked_hits "$(ikg_blocked_hits)"),"
    status+="$(ikg_num eula "$(ikg_eula_accepted && echo 1 || echo 0)"),"
    status+="$(ikg_kv log_dir "$IK_LOG_DIR"),"
    status+="$(ikg_kv log_usage "$usage")"
    status+="}"

    json_append __json_result__ status:json
}

__show_flags() {
    local flags="{" k v first=1
    if [ -f "$BOOT_ARGS" ]; then
        while IFS='=' read -r k v; do
            case "$k" in ''|\#*) continue ;; esac
            [ "$first" = 1 ] || flags+=","
            first=0
            flags+="$(ikg_kv "$k" "$v")"
        done < "$BOOT_ARGS"
    fi
    flags+="}"
    json_append __json_result__ flags:json
}

__show_plugins() {
    # 注意: 变量名必须与 json_append 的键名一致(json 类型是直接 `"键":${变量}` 展开),
    # 否则会变成 "plugins":{} —— 前端 (d.plugins||[]).forEach 就会报错
    local plugins="[" d name first=1 z
    for d in "$IK_PLUGIN_DIR"/*/ ; do
        [ -f "$d/Release" ] || continue
        name="$(basename "$d")"
        case "$name" in .*) continue ;; esac
        [ "$first" = 1 ] || plugins+=","
        first=0
        plugins+="{"
        plugins+="$(ikg_kv name "$name"),"
        plugins+="$(ikg_kv version "$(sed -n 's/^version=//p' "$d/Release" 2>/dev/null | head -n1)"),"
        plugins+="$(ikg_kv plugin "$(sed -n 's/^plugin=//p' "$d/Release" 2>/dev/null | head -n1)"),"
        plugins+="$(ikg_kv state "$(cat "$IK_PLUGIN_DIR/.state/$name" 2>/dev/null | tr '\n' ' ' | sed 's/  */ /g')"),"
        plugins+="$(ikg_num files "$(find "$d" -type f 2>/dev/null | wc -l)")"
        plugins+="}"
    done
    plugins+="]"

    # 待安装的 zip 包
    local pending="[" first2=1
    for z in "$IK_PLUGIN_DIR"/*.zip ; do
        [ -f "$z" ] || continue
        [ "$first2" = 1 ] || pending+=","
        first2=0
        pending+="{ $(ikg_kv name "$(basename "$z")") }"
    done
    pending+="]"

    json_append __json_result__ plugins:json
    json_append __json_result__ pending:json
}

__show_eula() {
    local accepted=0 when=""
    if ikg_eula_accepted; then
        accepted=1
        when="$(sed -n 's/^time=//p' "$IK_EULA_FILE" 2>/dev/null | head -n1)"
    fi
    local eula="{"
    eula+="$(ikg_num accepted "$accepted"),"
    eula+="$(ikg_kv version "$IK_EULA_VER"),"
    eula+="$(ikg_kv time "$when"),"
    eula+="$(ikg_kv file "$IK_EULA_FILE"),"
    eula+="$(ikg_kv text "$(ikg_eula_text)")"
    eula+="}"
    json_append __json_result__ eula:json
}

__show_probe() {
    local running=0 text
    pgrep -f "ikaudit probe" >/dev/null 2>&1 && running=1
    text="$(ikg_tail_file "$IK_PROBE_OUT" 60)"
    local probe="{"
    probe+="$(ikg_num running "$running"),"
    probe+="$(ikg_kv file "$IK_PROBE_OUT"),"
    probe+="$(ikg_kv text "$text")"
    probe+="}"
    json_append __json_result__ probe:json
}

# ---------------------------------------------------------------- 磁盘 / 扩容

# 分区大小(MiB)  ikg_part_mib sda3
ikg_part_mib() {
    local s
    s="$(cat "/sys/class/block/$1/size" 2>/dev/null | tr -d ' \r')"
    case "$s" in '' | *[!0-9]*) return 1 ;; esac
    echo $((s / 2048))
}

# 分区起始扇区  ikg_part_start sda3
ikg_part_start() {
    cat "/sys/class/block/$1/start" 2>/dev/null | tr -d ' \r'
}

# df 的某一列(MiB)  ikg_df_mib <挂载点> <列号>
ikg_df_mib() {
    df -m "$1" 2>/dev/null | tail -n1 | awk -v c="$2" '{print $c}' | tr -d ' \r'
}

# 第一个"不能动"的逻辑分区(sda6 及以后, 比如用户绑了业务的数据盘)的起始扇区; 没有则空。
ikg_keep_start() {
    local p s lim=""
    for p in sda6 sda7 sda8 sda9 sda10 sda11 sda12; do
        s="$(ikg_part_start "$p")"
        case "$s" in '' | *[!0-9]*) continue ;; esac
        { [ -z "$lim" ] || [ "$s" -lt "$lim" ]; } && lim="$s"
    done
    [ -n "$lim" ] && echo "$lim"
}

# 扩容上限(MiB)。规则与 scripts/09_expand_mnt.sh 完全一致:
#   新的 /etc/log 要放得下它现在的内容(再加 IK_EXPAND_RESERVE 余量),
#   而且不许动 sda6 这类保留分区 —— 所以 sda5 的可用上界是
#   (保留分区起始 - 2049) 或 磁盘末尾。
#   /etc/mnt=[start, start+mib*2048-1] 之后: 1MiB 对齐 -> EBR(2048) -> /etc/log
ikg_expand_max() {
    local start total upp used keep need_sec max_mib
    start="$(ikg_part_start sda3)"
    total="$(cat /sys/class/block/sda/size 2>/dev/null | tr -d ' \r')"
    case "${start}${total}" in *[!0-9]* | '') return 1 ;; esac

    upp=$((total - 1))
    keep="$(ikg_keep_start)"
    [ -n "$keep" ] && upp=$((keep - 2049))

    used="$(ikg_df_mib /etc/log 3)"
    case "$used" in '' | *[!0-9]*) used=0 ;; esac
    need_sec=$(( (used + IK_EXPAND_RESERVE) * 2048 ))
    [ "$need_sec" -lt $((256 * 2048)) ] && need_sec=$((256 * 2048))

    max_mib=$(( (upp - need_sec - 2047 - start) / 2048 ))
    [ "$max_mib" -gt 0 ] && echo "$max_mib"
}

# 待执行的扩容请求(MiB), 没有则空
ikg_expand_pending() {
    sed -n 's/^mnt_mib=//p' "$IK_EXPAND_REQ" 2>/dev/null | head -n1 | tr -d ' \r'
}

# MiB -> 给人看的 G(1024 进制), 页面/提示统一用 G
ikg_g() {
    awk -v m="${1:-0}" 'BEGIN{ g = m / 1024; if (g >= 100) printf "%.0fG", g; else printf "%.2fG", g }'
}

__show_disk() {
    local mnt_mib log_mib tot mnt_used log_used log_avail max pend keep disk
    mnt_mib="$(ikg_part_mib sda3)"
    log_mib="$(ikg_part_mib sda5)"
    tot="$(ikg_part_mib sda)"
    mnt_used="$(ikg_df_mib /etc/mnt 3)"
    log_used="$(ikg_df_mib /etc/log 3)"
    log_avail="$(ikg_df_mib /etc/log 4)"
    max="$(ikg_expand_max)"
    pend="$(ikg_expand_pending)"
    keep="$(ikg_keep_start)"
    disk="{"
    disk+="$(ikg_num mnt_mib "$mnt_mib"),"
    disk+="$(ikg_num mnt_used "$mnt_used"),"
    disk+="$(ikg_num log_mib "$log_mib"),"
    disk+="$(ikg_num log_used "$log_used"),"
    disk+="$(ikg_num log_avail "$log_avail"),"
    disk+="$(ikg_num total_mib "$tot"),"
    disk+="$(ikg_num max_mib "$max"),"
    disk+="$(ikg_num keep_mib "$( [ -n "$keep" ] && echo $(( (tot * 2048 - keep) / 2048 )) || echo 0 )"),"
    disk+="$(ikg_num pending "$pend"),"
    disk+="$(ikg_num reserve "$IK_EXPAND_RESERVE"),"
    disk+="$(ikg_kv expand_log "$(ikg_tail_file "$IK_EXPAND_LOG" 60)")"
    disk+="}"
    json_append __json_result__ disk:json
}

__show_logs() {
    local audit dns boot conn block report
    audit="$(ikg_tail_file "$(ikg_day_file audit)" 120)"
    dns="$(ikg_tail_file "$(ikg_day_file dns)" 80)"
    boot="$(ikg_tail_file "$IK_LOG_DIR/boot.log" 80)"
    conn="$(ikg_tail_file "$(ikg_day_file conn)" 60)"
    block="$(ikg_tail_file "$(ikg_day_file block)" 60)"
    report="$(ikg_tail_file "$IK_LOG_DIR/report.txt" 40)"
    local logs="{"
    logs+="$(ikg_kv audit "$audit"),"
    logs+="$(ikg_kv conn "$conn"),"
    logs+="$(ikg_kv dns "$dns"),"
    logs+="$(ikg_kv block "$block"),"
    logs+="$(ikg_kv boot "$boot"),"
    logs+="$(ikg_kv report "$report")"
    logs+="}"
    json_append __json_result__ logs:json
}

show()
{
    Show __json_result__
}

# ---------------------------------------------------------------- seting

__apply_for() {
    local k="$1"
    case "$k" in
        backdoor)  ikg_run_script 02_disable_backdoor.sh ;;
        plugins)   ikg_run_script 03_enable_plugins.sh ;;
        cron)      ikg_run_script 04_enable_cron.sh ;;
        shell)     ikg_run_script 05_enable_shell.sh ;;
        audit)     ikg_run_script 06_enable_audit.sh ;;
        probe)
            # 定时自检: 重建定时任务(probe=1 才加入 crontab, =0 则移除)
            "$IK_IKAUDIT" cronsync >/dev/null 2>&1
            ;;
    esac
    return 0
}

seting()
{
    local k
    case "$key" in
        ssh|sshd)        k="sshd" ;;
        backdoor)        k="backdoor" ;;
        backdoor_hosts)  k="backdoor_hosts" ;;
        plugins)         k="plugins" ;;
        cron)            k="cron" ;;
        shell)           k="shell" ;;
        audit)           k="audit" ;;
        probe)           k="probe" ;;
        *)               echo "不支持的配置项: $key" ; return 1 ;;
    esac

    case "$value" in
        0|1) ;;
        *) echo "value 只能为 0 或 1" ; return 1 ;;
    esac

    test -f "$BOOT_ARGS" || : > "$BOOT_ARGS"
    if grep -q "^$k=" "$BOOT_ARGS" 2>/dev/null; then
        sed -i "s|^$k=.*|$k=$value|" "$BOOT_ARGS"
    else
        echo "$k=$value" >> "$BOOT_ARGS"
    fi
    Syslog "[ikguard] 开关变更: $k=$value"
    ikg_audit INFO "flag.change" "开关变更 $k=$value"

    __apply_for "$k" "$value"
    echo "$k=$value 已保存并生效"
    return 0
}

# ---------------------------------------------------------------- 使用条款

eula()
{
    local op="${op:-accept}"
    mkdir -p "$IK_PLUGIN_DIR" 2>/dev/null
    case "$op" in
        accept)
            {
                echo "accepted=1"
                echo "version=$IK_EULA_VER"
                echo "time=$(date '+%Y-%m-%d %H:%M:%S')"
                echo "from=${SRC_IP:-web}"
            } > "$IK_EULA_FILE"
            Syslog "[ikguard] 已同意《使用条款与免责声明》$IK_EULA_VER"
            ikg_audit INFO "eula.accept" "用户同意使用条款 $IK_EULA_VER"
            # 同意后立刻把插件卡片换成正式插件
            ikg_run_script 03_enable_plugins.sh
            echo "使用条款已同意，插件功能已启用"
            ;;
        reject)
            rm -f "$IK_EULA_FILE" 2>/dev/null
            ikg_audit INFO "eula.reject" "用户拒绝使用条款"
            ikg_run_script 03_enable_plugins.sh
            echo "已记录为不同意，插件功能保持关闭"
            ;;
        *)  echo "不支持的 op: $op" ; return 1 ;;
    esac
    return 0
}

# ---------------------------------------------------------------- 其它动作

apply()
{
    ikg_run_script 02_disable_backdoor.sh
    ikg_run_script 06_enable_audit.sh
    echo "已重新应用后门阻断与审计"
    return 0
}

plugin()
{
    local op="${op:-scan}" name="$name" src base arch
    ikg_eula_accepted || { echo "需要先同意《使用条款》才能使用插件功能"; return 1; }
    test -x "$IK_IKPLUGIN" || { echo "插件系统不可用(缺少 $IK_IKPLUGIN)"; return 1; }
    arch="$IK_PLUGIN_DIR/.installed"

    case "$op" in
        scan)
            "$IK_IKPLUGIN" scan || return 1
            ikg_audit INFO "plugin.scan" "扫描并安装 /etc/mnt/plugins/*.zip"
            echo "已扫描并安装 /etc/mnt/plugins/*.zip"
            ;;
        list)
            "$IK_IKPLUGIN" list
            ;;
        install)
            [ -n "$name" ] || { echo "缺少 name"; return 1; }
            base="$(basename "$name")"
            case "$base" in
                *.zip|*.ZIP) ;;
                *) echo "只支持 .zip 插件包"; return 1 ;;
            esac
            src="$IK_IMPORT_DIR/$base"
            [ -f "$src" ] || { echo "未找到上传的插件包: $base(请先通过上传接口上传)"; return 1; }
            mkdir -p "$arch" 2>/dev/null
            cp -f "$src" "$arch/$base" 2>/dev/null
            if ! "$IK_IKPLUGIN" install "$src"; then
                echo "插件安装失败: $base"
                return 1
            fi
            rm -f "$src" 2>/dev/null
            ikg_audit INFO "plugin.install" "上传安装插件包: $base"
            echo "插件已安装: $base"
            ;;
        remove)
            [ -n "$name" ] || { echo "缺少 name"; return 1; }
            "$IK_IKPLUGIN" remove "$name" || return 1
            ikg_audit INFO "plugin.remove" "卸载插件: $name"
            echo "已卸载: $name"
            ;;
        verify)
            [ -n "$name" ] || { echo "缺少 name"; return 1; }
            "$IK_IKPLUGIN" verify "$name"
            ;;
        *)  echo "不支持的 op: $op" ; return 1 ;;
    esac

    # 插件变更后同步 Web 资源与卡片
    ikg_run_script 03_enable_plugins.sh
    return 0
}

# 系统盘(/etc/mnt)扩容: 这里只写"目标大小"请求, 真正的改盘由开机脚本
# scripts/09_expand_mnt.sh 在启动时完成(用设备自带 fdisk/mke2fs/dd), 会自动重启一次。
# 提交成功 -> 记审计 + 8 秒后自动重启; 失败 -> 记审计并原样把原因返回给页面。
expand()
{
    local op="${op:-pending}" size="${size:-}" out rc max pend

    case "$op" in
    pending)
        pend="$(ikg_expand_pending)"
        if [ -n "$pend" ]; then
            echo "待执行扩容请求: /etc/mnt -> ${pend} MiB(重启后由开机脚本执行)"
        else
            echo "当前没有待执行的扩容请求"
        fi
        ;;

    log)
        ikg_tail_file "$IK_EXPAND_LOG" 100
        ;;

    cancel)
        rm -f "$IK_EXPAND_REQ" "$IK_PLUGIN_DIR/.expand.tries" 2>/dev/null
        ikg_audit INFO "disk.expand" "已撤销扩容请求"
        echo "已撤销扩容请求"
        ;;

    set)
        case "$size" in
        '' | *[!0-9]*) echo "请填写要扩到的系统盘大小"; return 1 ;;
        esac
        test -x "$IK_IKEXPAND" || { echo "缺少扩容工具: $IK_IKEXPAND"; return 1; }
        max="$(ikg_expand_max)"
        if [ -n "$max" ] && [ "$size" -gt "$max" ]; then
            ikg_audit WARN "disk.expand" "拒绝扩容 $(ikg_g "$size"): 超过上限 $(ikg_g "$max")"
            echo "超过上限: 最多 $(ikg_g "$max")(要给日志盘 /etc/log 留出它已占用的空间和 $(ikg_g "$IK_EXPAND_RESERVE") 余量, 且不能动保留分区)"
            return 1
        fi
        out="$("$IK_IKEXPAND" set "$size" 2>&1)"
        rc=$?
        if [ "$rc" != 0 ]; then
            ikg_audit WARN "disk.expand" "扩容请求失败($(ikg_g "$size")): $(printf '%s' "$out" | tr '\n' ' ')"
            printf '%s\n' "$out"
            return 1
        fi
        ikg_audit INFO "disk.expand" "已提交扩容请求: /etc/mnt -> $(ikg_g "$size"), 即将重启执行"
        printf '%s\n' "$out"
        echo "即将重启设备完成扩容: 启动过程中自动改盘, 期间会再自动重启一次(约 1~2 分钟)"
        # 留几秒给页面显示提示, 然后重启; trap 忽略 HUP, 免得请求结束把这个子进程带走
        (trap '' HUP; sleep 8; reboot) >/dev/null 2>&1 &
        ;;

    *)
        echo "不支持的 op: $op"
        return 1
        ;;
    esac
    return 0
}

# 云端连通性自检: 仅由用户点击"开始自检"触发一次(后台执行, 约 20 秒,
# 结果写 last-probe.txt 由页面轮询)。不参与 cron, 也不在开机时执行。
probe()
{
    mkdir -p "$IK_LOG_DIR" 2>/dev/null
    if pgrep -f "ikaudit probe" >/dev/null 2>&1; then
        echo "自检正在进行中，请稍候刷新"
        return 0
    fi
    # 忽略 SIGHUP: 请求结束后父进程退出不能把自检带下去
    ( trap '' HUP; "$IK_IKAUDIT" probe > "$IK_PROBE_OUT" 2>&1 ) &
    echo "云端连通性自检已开始，约 20 秒后查看结果"
    return 0
}

logclear()
{
    # 当天日志 + 滚动出来的 .1 一起清, 避免留下半截历史
    local k
    mkdir -p "$IK_LOG_DIR" 2>/dev/null
    for k in audit conn dns block; do
        : > "$IK_LOG_DIR/$k-$(date +%Y%m%d).log" 2>/dev/null
        rm -f "$IK_LOG_DIR/$k-"*.log.1 2>/dev/null
    done
    Syslog "[ikguard] 审计日志已清空"
    echo "审计日志已清空"
    return 0
}
